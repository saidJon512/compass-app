# ═══ Telegram ═══
# @BotFather bergan token
BOT_TOKEN=

# Mini App manzili (HTTPS bo'lishi SHART).
# Lokalda bo'sh qoldiring — run.py tunnel ochib manzilni o'zi topadi.
# Render'da ham bo'sh qoldiring — RENDER_EXTERNAL_URL dan avtomatik olinadi.
WEBAPP_URL=

# Chap tarafdagi doimiy tugma matni
MENU_BUTTON_TEXT=Open
APP_NAME=COMPASS Daraja Testi

# Har bir natijadan nusxa shu chatga yuboriladi
ADMIN_CHAT_ID=

# Ilovadagi «Natijalar» bo'limini ko'ra oladigan Telegram ID lar (vergul bilan).
# O'z ID ingizni botga /id yozib bilib olasiz. ADMIN_CHAT_ID avtomatik qo'shiladi.
ADMIN_IDS=

# ═══ Claude API (ixtiyoriy) ═══
# Bo'sh bo'lsa: xulosa shablondan tuziladi, yozma savollar berilmaydi.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ═══ Server ═══
HOST=0.0.0.0
PORT=8000

# Botni qanday ishlatish:
#   false — polling (lokal): jarayon to'xtamasdan ishlashi kerak
#   true  — webhook (server): Telegram yangilikni o'zi yuboradi va
#           uxlab qolgan bepul serverni uyg'otadi
USE_WEBHOOK=false

# Webhook manzilini himoyalovchi maxfiy satr.
# Bo'sh qoldirsangiz tokendan avtomatik hosil qilinadi.
WEBHOOK_SECRET=

# HTTPS manzil qayerdan olinadi (faqat lokal): cloudflared | ngrok | none
TUNNEL=cloudflared

# DIQQAT: true qilinsa Telegram imzosi tekshirilmaydi.
# Faqat brauzerda sinash uchun. Productionda HECH QACHON yoqmang.
ALLOW_INSECURE_DEV=false

# ═══ Ma'lumotlar bazasi ═══
# Bo'sh = SQLite (lokal fayl).
# Postgres ulanish satri berilsa (masalan Neon) — o'sha ishlatiladi.
# Render'ning bepul diski VAQTINCHALIK, shuning uchun serverda Postgres kerak.
DATABASE_URL=
DB_PATH=data/sessions.db
